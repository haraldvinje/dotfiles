[global_config]
  ask_before_closing = never
[keybindings]
  go_up = <Primary>Up
  go_down = <Primary>Down
  go_left = <Primary>Left
  go_right = <Primary>Right
  close_term = <Primary>w
[profiles]
  [[default]]
    icon_bell = False
    background_color = "#282828"
    background_darkness = 0.93
    background_type = transparent
    cursor_shape = block
    font = Hack Nerd Font 12
    foreground_color = "#ebdbb2"
    show_titlebar = False
    scrollbar_position = hidden
    palette = "#2e3436:#cc0000:#c1e855:#c4a000:#3465a4:#75507b:#06989a:#d3d7cf:#555753:#ef2929:#8ae234:#fce94f:#729fcf:#ad7fa8:#34e2e2:#eeeeec"
    use_system_font = False
[layouts]
  [[default]]
    [[[window0]]]
      type = Window
      parent = ""
    [[[child1]]]
      type = Terminal
      parent = window0
[plugins]
