#!/usr/bin/env bash
# asdf-update — bump every asdf-managed tool to its latest version and write it
# to $HOME/.tool-versions, with special handling for java and gradle.
#
# Run as your normal user (not sudo). This is also where `uv` gets updated,
# since uv is an asdf-managed tool.

set -uo pipefail

export PATH="${ASDF_DATA_DIR:-$HOME/.asdf}/shims:${PATH:-/usr/bin}"

if ! command -v asdf >/dev/null 2>&1; then
  printf 'asdf not found on PATH\n' >&2
  exit 1
fi

set_global() {
  local tool=$1 version=$2

  if [[ -z ${version} ]]; then
    printf '!! skipping %s — could not determine a version\n\n' "${tool}"
    return 1
  fi

  # asdf 0.16+: --home writes to $HOME/.tool-versions (the old "global").
  asdf install "${tool}" "${version}" \
    && asdf set --home "${tool}" "${version}" \
    && printf '✓ %s %s set in ~/.tool-versions\n\n' "${tool}" "${version}"
}

mapfile -t plugins < <(asdf plugin list 2>/dev/null)

if ((${#plugins[@]} == 0)); then
  printf 'No asdf plugins installed.\n'
  exit 0
fi

for tool in "${plugins[@]}"; do
  case "$tool" in
    java|gradle) continue ;;
  esac
  set_global "${tool}" "$(asdf latest "${tool}")"
done

if printf '%s\n' "${plugins[@]}" | grep -qx java; then
  # Prefer newest OpenJDK build over asdf's generic "latest" vendor.
  latest_openjdk=$(asdf list all java 2>/dev/null | grep '^openjdk' | sort -V | tail -1)
  set_global java "${latest_openjdk}"
fi

if printf '%s\n' "${plugins[@]}" | grep -qx gradle; then
  latest_gradle=$(asdf list all gradle 2>/dev/null | grep -E '^[0-9]+\.[0-9]+(\.[0-9]+)?$' | sort -V | tail -1)
  set_global gradle "${latest_gradle}"
fi

asdf reshim
