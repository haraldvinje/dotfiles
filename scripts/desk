#!/usr/bin/env bash
# desk — one verb per desktop action (menu, clipboard, capture, theme, …).
# i3, polybar, and agents should call this instead of ad-hoc one-liners.
set -u

DESK="${HOME}/.scripts/desk"
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/desk"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/desk"
I3CONF="${XDG_CONFIG_HOME:-$HOME/.config}/i3/config"
ROFI_THEME="${XDG_CONFIG_HOME:-$HOME/.config}/rofi/clean-blur.rasi"
WALLDIR="${DESK_WALLPAPERS:-$HOME/Pictures/Wallpapers}"
CITY="${DESK_WEATHER_CITY:-Oslo}"

mkdir -p "$CACHE"

have() { command -v "$1" >/dev/null 2>&1; }

wait_rofi_gone() {
  local n="${1:-20}" i
  for i in $(seq 1 "$n"); do
    pgrep -x rofi >/dev/null || return 0
    sleep 0.05
  done
  return 1
}

rofi_dmenu() {
  local prompt="$1"
  shift
  if ! wait_rofi_gone 24; then
    notify -u low "desk" "Close the current menu first"
    return 1
  fi
  rofi -dmenu -i -p "$prompt" -theme "$ROFI_THEME" "$@"
}

notify() {
  if have dunstify; then
    dunstify -a desk "$@"
  elif have notify-send; then
    notify-send "$@"
  fi
}

need() {
  local bin="$1"
  if ! have "$bin"; then
    notify -u low "desk" "Missing $bin"
    return 1
  fi
  return 0
}

# --- commands.json ----------------------------------------------------------

cmd_label() {
  if have jq; then
    printf '%s' "$1" | jq -r '.label'
  else
    printf '%s' "$1" | sed -n 's/.*"label":"\([^"]*\)".*/\1/p'
  fi
}
cmd_run() {
  if have jq; then
    printf '%s' "$1" | jq -r '.run'
  else
    printf '%s' "$1" | sed -n 's/.*"run":"\([^"]*\)".*/\1/p'
  fi
}

list_commands() {
  local file="$CONF/commands.json"
  if [ -r "$file" ] && have jq; then
    jq -c '.[]' "$file"
    return 0
  fi
  # Minimal palette if jq / the json file is not available yet.
  printf '%s\n' \
    '{"label":"Apps","run":"apps"}' \
    '{"label":"Clipboard history","run":"clipboard"}' \
    '{"label":"Notifications: replay last","run":"notify replay"}' \
    '{"label":"Notifications: toggle DND","run":"notify dnd-toggle"}' \
    '{"label":"Network: Wi-Fi","run":"wifi"}' \
    '{"label":"Audio: outputs","run":"audio"}' \
    '{"label":"Bluetooth","run":"bluetooth"}' \
    '{"label":"Power","run":"power"}' \
    '{"label":"Theme: wallpaper","run":"theme pick"}' \
    '{"label":"Keybindings","run":"keys"}' \
    '{"label":"AI: agents","run":"agent pick"}' \
    '{"label":"Defaults: apps","run":"default"}' \
    '{"label":"Install: package","run":"pkg install"}' \
    '{"label":"Remove: package","run":"pkg remove"}'
}

# --- menu / rofi script mode ------------------------------------------------

desk_apps() {
  rofi -show drun -show-icons -theme "$ROFI_THEME"
}

desk_menu() {
  local pending="$CACHE/pending-run"
  rm -f "$pending"
  rofi -show desk \
    -modi "desk:${HOME}/.scripts/desk-menu,drun,window" \
    -show-icons \
    -theme "$ROFI_THEME"
  # Rofi forbids nesting. Commands that open another menu run after this one exits.
  if [ -s "$pending" ]; then
    local run
    run="$(cat "$pending")"
    rm -f "$pending"
    wait_rofi_gone 24 || true
    # shellcheck disable=SC2086
    exec "$DESK" $run
  fi
}

desk_rofi() {
  local selected="${1:-}"
  local row label pending="$CACHE/pending-run"
  if [ -z "$selected" ]; then
    while IFS= read -r row; do
      [ -n "$row" ] || continue
      cmd_label "$row"
    done < <(list_commands)
    return 0
  fi
  while IFS= read -r row; do
    label="$(cmd_label "$row")"
    if [ "$label" = "$selected" ]; then
      cmd_run "$row" >"$pending"
      return 0
    fi
  done < <(list_commands)
}

# --- clipboard --------------------------------------------------------------

desk_clipboard() {
  need greenclip || return 1
  rofi -modi "clipboard:greenclip print" -show clipboard -theme "$ROFI_THEME"
}

# --- notifications ----------------------------------------------------------

desk_notify() {
  local sub="${1:-status}"
  need dunstctl || return 1
  case "$sub" in
    replay)
      dunstctl history-pop
      ;;
    replay-many)
      local i
      for i in $(seq 1 10); do
        dunstctl history-pop || break
      done
      ;;
    dnd-on)
      dunstctl set-paused true
      notify -u low -r 2601 "Notifications" "Do not disturb on"
      ;;
    dnd-off)
      dunstctl set-paused false
      notify -u low -r 2601 "Notifications" "Do not disturb off"
      ;;
    dnd-toggle)
      if [ "$(dunstctl is-paused)" = "true" ]; then
        desk_notify dnd-off
      else
        desk_notify dnd-on
      fi
      ;;
    status)
      if [ "$(dunstctl is-paused 2>/dev/null)" = "true" ]; then
        printf '%s\n' "%{T3}󰂛%{T-} DND"
      fi
      ;;
    *)
      echo "usage: desk notify replay|replay-many|dnd-toggle|dnd-on|dnd-off|status" >&2
      return 1
      ;;
  esac
}

# --- capture ----------------------------------------------------------------

_grab_region() {
  local dest="$1"
  if have maim; then
    maim -s -u "$dest"
  elif have flameshot; then
    flameshot gui --raw >"$dest"
    [ -s "$dest" ]
  elif have scrot; then
    scrot -s "$dest"
  else
    notify "desk" "Need maim, flameshot, or scrot for a region grab"
    return 1
  fi
}

desk_capture() {
  local sub="${1:-}"
  local tmp
  tmp="$(mktemp --suffix=.png)"
  # shellcheck disable=SC2064
  trap "rm -f '$tmp'" RETURN

  case "$sub" in
    ocr)
      need tesseract || return 1
      _grab_region "$tmp" || return 1
      local tesslang=""
      if tesseract --list-langs 2>/dev/null | grep -qx eng; then
        tesslang="-l eng"
      fi
      # shellcheck disable=SC2086
      if tesseract "$tmp" stdout $tesslang 2>/dev/null | xclip -selection clipboard; then
        notify -u low "OCR" "Text copied to clipboard"
      else
        notify -u low "OCR" "No text found"
        return 1
      fi
      ;;
    qr)
      need zbarimg || return 1
      _grab_region "$tmp" || return 1
      local decoded
      decoded="$(zbarimg --quiet --raw "$tmp" 2>/dev/null | head -n1 || true)"
      rm -f "$tmp"
      if [ -z "$decoded" ]; then
        notify -u low "QR" "No code in selection"
        return 1
      fi
      printf '%s' "$decoded" | xclip -selection clipboard
      if [[ "$decoded" == otpauth://* ]]; then
        notify -u low "QR" "otpauth copied (not written to disk)"
      else
        notify -u low "QR" "Decoded value copied"
      fi
      ;;
    annotate)
      need flameshot || return 1
      flameshot gui
      ;;
    region)
      xfce4-screenshooter -r
      ;;
    full)
      xfce4-screenshooter -f
      ;;
    window)
      xfce4-screenshooter -w
      ;;
    *)
      echo "usage: desk capture ocr|qr|annotate|region|full|window" >&2
      return 1
      ;;
  esac
}

# --- theme ------------------------------------------------------------------

load_defaults() {
  local file="$CONF/theme/default.conf"
  [ -r "$file" ] || return 1
  # shellcheck disable=SC1090
  set -a
  # strip comments / blanks
  eval "$(grep -E '^[A-Za-z_][A-Za-z0-9_]*=' "$file")"
  set +a
}

load_wal() {
  local wal="${XDG_CACHE_HOME:-$HOME/.cache}/wal/colors.json"
  have jq || return 1
  [ -r "$wal" ] || return 1
  bg="$(jq -r '.special.background' "$wal")"
  fg="$(jq -r '.special.foreground' "$wal")"
  text="$fg"
  text_alt="$(jq -r '.colors.color8' "$wal")"
  muted="$text_alt"
  accent="$(jq -r '.colors.color4' "$wal")"
  warn="$(jq -r '.colors.color3' "$wal")"
  urgent="$(jq -r '.colors.color1' "$wal")"
  clock="$(jq -r '.colors.color5' "$wal")"
  cpu="$warn"
  memory="$(jq -r '.colors.color2' "$wal")"
  disk="$(jq -r '.colors.color6' "$wal")"
  network="$(jq -r '.colors.color5' "$wal")"
  volume="$(jq -r '.colors.color1' "$wal")"
  black="$(jq -r '.colors.color0' "$wal")"
  red="$(jq -r '.colors.color1' "$wal")"
  green="$(jq -r '.colors.color2' "$wal")"
  yellow="$(jq -r '.colors.color3' "$wal")"
  blue="$(jq -r '.colors.color4' "$wal")"
  magenta="$(jq -r '.colors.color5' "$wal")"
  cyan="$(jq -r '.colors.color6' "$wal")"
  emphasis="$(jq -r '.colors.color8' "$wal")"
  dunst_bg="$bg"
  dunst_frame="$accent"
  dunst_critical_bg="$bg"
  dunst_critical_fg="$fg"
  # Bar stays tinted, not see-through.
  bg_alpha="#e0${bg#\#}"
  bg_alt="#cc${bg#\#}"
}

write_theme_files() {
  mkdir -p "$CACHE"

  cat >"$CACHE/polybar-colors.ini" <<EOF
[colors]
bg = ${bg_alpha}
bg-alt = ${bg_alt}
fg = ${fg}
muted = ${muted}
accent = ${accent}
warn = ${warn}
urgent = ${urgent}
clock = ${clock}
cpu = ${cpu}
memory = ${memory}
disk = ${disk}
network = ${network}
volume = ${volume}
EOF

  cat >"$CACHE/rofi-colors.rasi" <<EOF
* {
    black: ${black};
    red: ${red};
    green: ${green};
    yellow: ${yellow};
    blue: ${blue};
    magenta: ${magenta};
    cyan: ${cyan};
    emphasis: ${emphasis};
    text: ${text};
    text-alt: ${text_alt};
    fg: ${fg};
    bg: ${bg};
}
EOF

  cat >"$CACHE/dunst-colors" <<EOF
[urgency_low]
background = "${dunst_bg}"
foreground = "${fg}"
highlight = "${accent}"

[urgency_normal]
background = "${dunst_bg}"
foreground = "${fg}"
highlight = "${accent}"

[urgency_critical]
background = "${dunst_critical_bg}"
foreground = "${dunst_critical_fg}"
frame_color = "${urgent}"
highlight = "${urgent}"
EOF

  local rofi_link="${XDG_CONFIG_HOME:-$HOME/.config}/rofi/colors.generated.rasi"
  local poly_link="${XDG_CONFIG_HOME:-$HOME/.config}/polybar/colors.generated.ini"
  ln -sfn "$CACHE/rofi-colors.rasi" "$rofi_link"
  ln -sfn "$CACHE/polybar-colors.ini" "$poly_link"
}

reload_theme_consumers() {
  if [ -x "${XDG_CONFIG_HOME:-$HOME/.config}/polybar/launch.sh" ]; then
    "${XDG_CONFIG_HOME:-$HOME/.config}/polybar/launch.sh" >/dev/null 2>&1 &
  fi
  if have dunstctl; then
    dunstctl reload >/dev/null 2>&1 || true
  fi
}

_desk_wallpaper_files() {
  [ -d "$WALLDIR" ] || return 1
  find "$WALLDIR" -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \)
}

_desk_theme_from_image() {
  local img="$1"
  [ -n "$img" ] && [ -f "$img" ] || return 1
  if have wal; then
    wal -n -i "$img" >/dev/null
  fi
  desk_theme apply
}

desk_theme_randomize() {
  local files=() f n i primary theme_img
  local outputs=() args=()

  [ -d "$WALLDIR" ] || { notify "Theme" "No $WALLDIR"; return 1; }
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    files+=("$f")
  done < <(_desk_wallpaper_files | shuf 2>/dev/null || _desk_wallpaper_files | sort -R)
  [ "${#files[@]}" -gt 0 ] || { notify "Theme" "No images in $WALLDIR"; return 1; }

  while IFS= read -r f; do
    [ -n "$f" ] || continue
    outputs+=("$f")
  done < <(xrandr --query | awk '$2 == "connected" { print $1 }')
  n="${#outputs[@]}"
  [ "$n" -gt 0 ] || n=1

  for i in $(seq 0 $((n - 1))); do
    args+=("${files[$((i % ${#files[@]}))]}")
  done
  feh --no-fehbg --bg-fill "${args[@]}" || true

  primary="$(xrandr --query | awk '$2 == "connected" && / primary / { print $1; exit }')"
  theme_img="${args[0]}"
  if [ -n "$primary" ]; then
    for i in "${!outputs[@]}"; do
      if [ "${outputs[$i]}" = "$primary" ]; then
        theme_img="${args[$i]}"
        break
      fi
    done
  fi
  _desk_theme_from_image "$theme_img"
}

desk_theme() {
  local sub="${1:-ensure}"
  case "$sub" in
    ensure)
      load_defaults || true
      if [ -r "${XDG_CACHE_HOME:-$HOME/.cache}/wal/colors.json" ]; then
        load_wal || load_defaults
      fi
      write_theme_files
      ;;
    apply)
      load_defaults
      load_wal || true
      write_theme_files
      reload_theme_consumers
      ;;
    pick)
      need rofi || return 1
      [ -d "$WALLDIR" ] || { notify "Theme" "No $WALLDIR"; return 1; }
      local pick
      pick="$(_desk_wallpaper_files | sort | rofi_dmenu "Wallpaper")" || return 0
      [ -n "$pick" ] || return 0
      feh --no-fehbg --bg-fill "$pick" || true
      _desk_theme_from_image "$pick"
      ;;
    randomize|random)
      desk_theme_randomize
      ;;
    catalog|variety)
      desk_theme_catalog
      ;;
    fetch) desk_theme_fetch "${2:-8}" ;;
    review) desk_theme_review ;;
    next) desk_variety next ;;
    prev|previous) desk_variety prev ;;
    keep|favorite) desk_variety keep ;;
    skip|trash) desk_variety skip ;;
    prefs) desk_variety prefs ;;
    recolor|sync)
      if have variety && pgrep -x variety >/dev/null; then
        _desk_variety_apply_current
      else
        desk_theme apply
      fi
      ;;
    *)
      echo "usage: desk theme ensure|apply|pick|randomize|catalog|fetch|review|next|prev|keep|skip|prefs" >&2
      return 1
      ;;
  esac
}

_desk_variety_ensure() {
  need variety || { notify "Theme" "Install variety: pacman -S variety"; return 1; }
  mkdir -p "$WALLDIR"
  if ! pgrep -x variety >/dev/null; then
    variety >/dev/null 2>&1 &
    local i
    for i in $(seq 1 40); do
      pgrep -x variety >/dev/null && break
      sleep 0.15
    done
    sleep 0.8
  fi
  pgrep -x variety >/dev/null || { notify "Theme" "Variety did not start"; return 1; }
}

_desk_variety_current_image() {
  local img
  img="$(variety --get 2>/dev/null || true)"
  if [ -z "$img" ] && [ -r "$HOME/.config/variety/wallpaper/wallpaper.jpg.txt" ]; then
    img="$(tr -d '\n' <"$HOME/.config/variety/wallpaper/wallpaper.jpg.txt")"
  fi
  [ -n "$img" ] && [ -f "$img" ] && printf '%s\n' "$img"
}

_desk_variety_apply_current() {
  local img
  img="$(_desk_variety_current_image)" || return 0
  [ -n "$img" ] || return 0
  if have wal; then
    wal -n -i "$img" >/dev/null
  fi
  desk_theme apply
}

desk_variety() {
  local sub="${1:-next}"
  _desk_variety_ensure || return 1
  case "$sub" in
    next)
      variety -n >/dev/null
      sleep 0.4
      _desk_variety_apply_current
      ;;
    prev|previous)
      variety -p >/dev/null
      sleep 0.4
      _desk_variety_apply_current
      ;;
    keep|favorite)
      variety -f >/dev/null
      notify -u low "Theme" "Kept in $WALLDIR"
      ;;
    skip|trash)
      variety -t >/dev/null
      sleep 0.4
      _desk_variety_apply_current
      notify -u low "Theme" "Skipped"
      ;;
    prefs|preferences)
      variety --preferences >/dev/null 2>&1 &
      ;;
    *)
      echo "usage: desk theme next|prev|keep|skip|prefs" >&2
      return 1
      ;;
  esac
}

desk_theme_catalog() {
  local choice
  choice="$(printf '%s\n' \
    "Fetch 8 into Wallpapers" \
    "Review (keep / skip)" \
    "Pick from library" \
    | rofi_dmenu "Wallpapers")" || return 0
  case "$choice" in
    "Fetch 8 into Wallpapers") desk_theme_fetch 8 ;;
    "Review (keep / skip)") desk_theme_review ;;
    "Pick from library") desk_theme pick ;;
  esac
}

_desk_wallhaven_hits() {
  curl -fsS -A "desk-wallpapers" --max-time 20 \
    "https://wallhaven.cc/api/v1/search?sorting=random&purity=100&categories=100&atleast=1920x1080&ratios=16x9,16x10,21x9"
}

_desk_wallhaven_save() {
  local id="$1" url="$2" dest ext
  ext="${url##*.}"
  ext="${ext%%\?*}"
  [ -n "$ext" ] || ext="jpg"
  dest="$WALLDIR/wallhaven-${id}.${ext}"
  [ ! -e "$dest" ] || return 1
  if curl -fsS -A "desk-wallpapers" --max-time 60 -o "$dest.tmp" "$url" && [ -s "$dest.tmp" ]; then
    mv "$dest.tmp" "$dest"
    printf '%s\n' "$dest"
    return 0
  fi
  rm -f "$dest.tmp"
  return 1
}

_desk_wallhaven_next_new() {
  local tries="${1:-4}" json id url dest t
  for t in $(seq 1 "$tries"); do
    json="$(_desk_wallhaven_hits)" || return 1
    while IFS=$'\t' read -r id url; do
      [ -n "$id" ] || continue
      dest="$(_desk_wallhaven_save "$id" "$url")" || continue
      printf '%s\n' "$dest"
      return 0
    done < <(printf '%s' "$json" | jq -r '.data[]? | [.id, .path] | @tsv')
  done
  return 1
}

desk_theme_fetch() {
  local n="${1:-8}" got=0 dest json id url tries=0
  need jq || return 1
  need curl || return 1
  mkdir -p "$WALLDIR"
  notify -u low "Theme" "Fetching $n wallpapers…"
  while [ "$got" -lt "$n" ] && [ "$tries" -lt 5 ]; do
    tries=$((tries + 1))
    json="$(_desk_wallhaven_hits)" || break
    while IFS=$'\t' read -r id url; do
      [ -n "$id" ] || continue
      [ "$got" -ge "$n" ] && break
      dest="$(_desk_wallhaven_save "$id" "$url")" || continue
      got=$((got + 1))
    done < <(printf '%s' "$json" | jq -r '.data[]? | [.id, .path] | @tsv')
  done
  if [ "$got" -eq 0 ]; then
    notify "Theme" "No new wallpapers (Wallhaven empty or all already saved)"
    return 1
  fi
  notify -u low "Theme" "Added $got to $WALLDIR"
}

desk_theme_review() {
  local dest choice
  need jq || return 1
  need curl || return 1
  mkdir -p "$WALLDIR"
  while true; do
    dest="$(_desk_wallhaven_next_new 6)" || { notify "Theme" "Could not download a wallpaper"; return 1; }
    feh --no-fehbg --bg-fill "$dest" || true
    choice="$(printf '%s\n' "Keep" "Skip" "Done" | rofi_dmenu "Wallpaper")" || choice="Done"
    case "$choice" in
      Keep)
        notify -u low "Theme" "Kept $(basename "$dest")"
        ;;
      Skip)
        rm -f "$dest"
        ;;
      *)
        return 0
        ;;
    esac
  done
}

# --- control panels ---------------------------------------------------------

desk_wifi() {
  local sub="${1:-tui}"
  case "$sub" in
    menu|rofi|pick) desk_wifi_rofi ;;
    tui|"")
      if have wifitui; then
        _desk_term "Wi-Fi" wifitui
      else
        desk_wifi_rofi
      fi
      ;;
    gui)
      if have nm-connection-editor; then
        nm-connection-editor &
      else
        desk_wifi_rofi
      fi
      ;;
    *)
      echo "usage: desk wifi [tui|rofi|gui]" >&2
      return 1
      ;;
  esac
}

desk_wifi_rofi() {
  need nmcli || return 1
  local lines choice ssid
  lines="$(
    {
      echo "Scan + refresh"
      echo "Connection editor"
      echo "Radio off"
      echo "Radio on"
      nmcli -t -f IN-USE,SSID,SIGNAL,SECURITY device wifi list \
        | awk -F: 'NF && $2 != "" {
            mark = ($1 == "*") ? "● " : "  "
            printf "%s%s  %s%%  %s\n", mark, $2, $3, $4
          }'
    }
  )"
  choice="$(printf '%s\n' "$lines" | rofi_dmenu "Wi-Fi")" || return 0
  [ -n "$choice" ] || return 0
  case "$choice" in
    "Scan + refresh") nmcli device wifi rescan >/dev/null; desk_wifi_rofi ;;
    "Connection editor") have nm-connection-editor && nm-connection-editor & ;;
    "Radio off") nmcli radio wifi off; notify -u low "Wi-Fi" "Off" ;;
    "Radio on") nmcli radio wifi on; notify -u low "Wi-Fi" "On" ;;
    *)
      ssid="$(printf '%s' "$choice" | sed -E 's/^[● ]+//; s/  +[0-9]+%.*//')"
      ssid="${ssid#"${ssid%%[![:space:]]*}"}"
      ssid="${ssid%"${ssid##*[![:space:]]}"}"
      [ -n "$ssid" ] || return 0
      if nmcli device wifi connect "$ssid"; then
        notify -u low "Wi-Fi" "Connected to $ssid"
      else
        notify -u low "Wi-Fi" "Could not connect to $ssid (saved secret?)"
      fi
      ;;
  esac
}

desk_audio() {
  local sub="${1:-tui}"
  case "$sub" in
    menu|rofi|pick) desk_audio_rofi ;;
    tui|"")
      if have wiremix; then
        _desk_term "Audio" wiremix
      else
        notify "desk" "Install wiremix, then retry (or use Audio quick)"
        desk_audio_rofi
      fi
      ;;
    gui)
      if have pavucontrol; then
        pavucontrol &
      else
        desk_audio_rofi
      fi
      ;;
    *)
      echo "usage: desk audio [tui|rofi|gui]" >&2
      return 1
      ;;
  esac
}

_desk_audio_sinks() {
  local json
  if have jq && json="$(pactl -f json list sinks 2>/dev/null)" && [ -n "$json" ]; then
    printf '%s\n' "$json" | jq -r '.[] | select(.name != null) | "\(.name)\t\(.description // .name)"'
    return 0
  fi
  pactl list sinks 2>/dev/null | awk '
    /^Sink / { if (n != "") print n "\t" (d == "" ? n : d); n = ""; d = "" }
    $1 == "Name:" { n = $2 }
    $1 == "Description:" { sub(/^[[:space:]]*Description:[[:space:]]*/, ""); d = $0 }
    END { if (n != "") print n "\t" (d == "" ? n : d) }
  '
}

_desk_audio_use_sink() {
  local sink="$1" id
  pactl set-default-sink "$sink"
  while IFS= read -r id; do
    [ -n "$id" ] || continue
    pactl move-sink-input "$id" "$sink" 2>/dev/null || true
  done < <(pactl list short sink-inputs 2>/dev/null | awk '{print $1}')
}

desk_audio_rofi() {
  need pactl || return 1
  local default muted vol prompt lines choice sink name desc mark
  default="$(pactl get-default-sink 2>/dev/null || true)"
  muted="$(pactl get-sink-mute @DEFAULT_SINK@ 2>/dev/null || true)"
  vol="$(pactl get-sink-volume @DEFAULT_SINK@ 2>/dev/null | grep -oE '[0-9]+%' | head -n1)"
  if printf '%s' "$muted" | grep -q yes; then
    prompt="Audio  muted"
    lines="Unmute"$'\n'
  else
    prompt="Audio  ${vol:-?}"
    lines="Mute"$'\n'
  fi
  while IFS=$'\t' read -r name desc; do
    [ -n "$name" ] || continue
    [ -n "$desc" ] || desc="$name"
    if [ "$name" = "$default" ]; then
      mark="● "
    else
      mark="  "
    fi
    lines+="${mark}${desc}"$'\n'
  done < <(_desk_audio_sinks)
  choice="$(printf '%s' "$lines" | awk 'NF' | rofi_dmenu "$prompt")" || return 0
  [ -n "$choice" ] || return 0
  case "$choice" in
    Mute|Unmute)
      pactl set-sink-mute @DEFAULT_SINK@ toggle
      return 0
      ;;
  esac
  choice="${choice#"${choice%%[![:space:]]*}"}"
  choice="${choice#● }"
  choice="${choice#"${choice%%[![:space:]]*}"}"
  while IFS=$'\t' read -r name desc; do
    [ -n "$desc" ] || desc="$name"
    if [ "$choice" = "$desc" ]; then
      sink="$name"
      break
    fi
  done < <(_desk_audio_sinks)
  [ -n "${sink:-}" ] || return 0
  _desk_audio_use_sink "$sink"
  notify -u low "Audio" "Output: $choice"
}

desk_cava() {
  if pgrep -x cava >/dev/null; then
    pkill -x cava
    return 0
  fi
  if have cava; then
    _desk_term "cava" cava
  else
    notify "desk" "Install cava: pacman -S cava"
  fi
}

desk_bluetooth() {
  local sub="${1:-tui}"
  case "$sub" in
    menu|rofi|pick) desk_bluetooth_rofi ;;
    tui|"")
      if have bluetui; then
        _desk_term "Bluetooth" bluetui
      else
        desk_bluetooth_rofi
      fi
      ;;
    gui)
      if have blueman-manager; then
        blueman-manager &
      else
        desk_bluetooth_rofi
      fi
      ;;
    *)
      echo "usage: desk bluetooth [tui|rofi|gui]" >&2
      return 1
      ;;
  esac
}

desk_bluetooth_rofi() {
  need bluetoothctl || return 1
  local lines choice mac name
  bluetoothctl power on >/dev/null 2>&1 || true
  lines="$(
    {
      echo "Power on"
      echo "Power off"
      echo "Scan 8s"
      bluetoothctl devices | awk '{mac=$2; $1=$2=""; sub(/^  /,""); printf "%s  %s\n", mac, $0}'
    }
  )"
  choice="$(printf '%s\n' "$lines" | rofi_dmenu "Bluetooth")" || return 0
  [ -n "$choice" ] || return 0
  case "$choice" in
    "Power on") bluetoothctl power on; notify -u low "Bluetooth" "On" ;;
    "Power off") bluetoothctl power off; notify -u low "Bluetooth" "Off" ;;
    "Scan 8s")
      bluetoothctl --timeout 8 scan on >/dev/null
      desk_bluetooth_rofi
      ;;
    *)
      mac="$(printf '%s' "$choice" | awk '{print $1}')"
      name="$(printf '%s' "$choice" | cut -d' ' -f2-)"
      if bluetoothctl connect "$mac"; then
        notify -u low "Bluetooth" "Connected $name"
      else
        bluetoothctl disconnect "$mac" && notify -u low "Bluetooth" "Disconnected $name"
      fi
      ;;
  esac
}

desk_display() {
  local lines choice
  lines="$(
    {
      echo "Reapply mapped layout"
      if have autorandr; then
        autorandr --list 2>/dev/null
      fi
    }
  )"
  choice="$(printf '%s\n' "$lines" | rofi_dmenu "Display")" || return 0
  [ -n "$choice" ] || return 0
  case "$choice" in
    "Reapply mapped layout")
      "${XDG_CONFIG_HOME:-$HOME/.config}/i3/scripts/monitor-reapply.sh"
      ;;
    *)
      need autorandr || return 1
      autorandr --load "$choice" || true
      "${XDG_CONFIG_HOME:-$HOME/.config}/polybar/launch.sh" >/dev/null 2>&1 &
      ;;
  esac
}

desk_power() {
  local choice
  choice="$(printf '%s\n' "Lock" "Logout" "Suspend" "Reboot" "Shutdown" | rofi_dmenu "Power")" || return 0
  case "$choice" in
    Lock) desk_lock ;;
    Logout) i3-msg exit ;;
    Suspend) systemctl suspend ;;
    Reboot) systemctl reboot ;;
    Shutdown) systemctl poweroff ;;
  esac
}

# --- weather / keys / misc --------------------------------------------------

desk_weather() {
  local brief full
  brief="$(curl -fsS --max-time 5 "https://wttr.in/${CITY}?format=%l:+%c+%t+%h+%w" || true)"
  full="$(curl -fsS --max-time 6 "https://wttr.in/${CITY}?0QT" || true)"
  if [ -n "$brief" ]; then
    notify "Weather" "${full:-$brief}"
  else
    notify "Weather" "Could not reach wttr.in"
  fi
}

desk_weather_bar() {
  # Temperature only — polybar's fonts drop the wttr.in emoji.
  curl -fsS --max-time 4 "https://wttr.in/${CITY}?format=%t" 2>/dev/null | tr -d '\n' || true
  echo
}

desk_keys() {
  [ -r "$I3CONF" ] || { notify "Keybindings" "No i3 config at $I3CONF"; return 1; }
  local line key cmd pick
  local rows=""
  while IFS= read -r line; do
    line="${line#"${line%%[![:space:]]*}"}"
    [[ "$line" == \#* ]] && continue
    [[ "$line" == bindsym* ]] || continue
    line="${line#bindsym }"
    line="${line#--release }"
    key="${line%% *}"
    cmd="${line#"$key"}"
    cmd="${cmd#"${cmd%%[![:space:]]*}"}"
    key="${key//\$mod/Super}"
    key="${key//Mod1/Alt}"
    key="${key//mod1/Alt}"
    key="${key//Control/Ctrl}"
    key="${key//control/Ctrl}"
    rows+="${key}  →  ${cmd}"$'\n'
  done <"$I3CONF"
  if [ -z "$rows" ]; then
    notify "Keybindings" "No bindsym lines found"
    return 1
  fi
  pick="$(printf '%s' "$rows" | rofi_dmenu "Keybindings")" || return 0
  [ -n "$pick" ] || return 0
  printf '%s' "${pick#*  →  }" | xclip -selection clipboard
  notify -u low "Keybindings" "Command copied"
}

desk_emoji() {
  if have rofimoji; then
    rofimoji
  else
    notify "desk" "rofimoji is not installed"
  fi
}

desk_lock() {
  if have i3lock-fancy-multimonitor; then
    i3lock-fancy-multimonitor -b=5x4
  elif have i3lock; then
    i3lock -c 11141a
  else
    notify "desk" "No lock screen found"
  fi
}

desk_update() {
  if [ -x "${HOME}/.scripts/full-update" ]; then
    if have terminator; then
      terminator -e "${HOME}/.scripts/full-update; echo; read -r _" &
    else
      "${HOME}/.scripts/full-update"
    fi
  else
    notify "desk" "full-update script missing"
  fi
}

_desk_in_term() {
  [ -t 0 ] && [ -t 1 ]
}

# TUI must be Terminator's child (same as grok): a shell wrapper drops the tty.
_desk_term() {
  local title="$1"
  shift
  if _desk_in_term; then
    "$@"
    return
  fi
  if have terminator; then
    terminator -T "$title" -x "$@" &
    return
  fi
  notify "desk" "Open a terminal and run: $*"
}

_desk_pkg_pick() {
  local prompt="$1"
  local preview="$2"
  fzf --multi --reverse --info=inline \
    --prompt="$prompt" \
    --header="Tab multi-select · Esc closes" \
    --preview "$preview" \
    --preview-window=right:60%:wrap \
    --bind "alt-p:toggle-preview,alt-j:preview-down,alt-k:preview-up"
}

# AUR name list (text). paru -Sl dumps packages.gz as binary; this decompresses it.
_desk_aur_names() {
  local cache="$CACHE/aur-packages.txt"
  local tmp="$cache.tmp"
  if [ ! -s "$cache" ] || [ -n "$(find "$cache" -mmin +1440 2>/dev/null)" ]; then
    echo "Refreshing AUR package list…" >&2
    if curl -fsS --max-time 20 https://aur.archlinux.org/packages.gz | gzip -dc >"$tmp"; then
      mv "$tmp" "$cache"
    else
      rm -f "$tmp"
      echo "Could not refresh AUR list (using cache if any)." >&2
    fi
  fi
  [ -s "$cache" ] && cat "$cache"
}

desk_pkg_preview() {
  local p="${1:-}"
  if [[ "$p" == *"  (AUR)" ]]; then
    paru --aur --color=never -Si "${p%"  (AUR)"}" 2>/dev/null
  elif [ -n "$p" ]; then
    pacman --color=never -Si "$p" 2>/dev/null
  fi
}

desk_pkg() {
  local sub="${1:-install}"
  if _desk_in_term; then
    desk_pkg_tui "$sub"
    return
  fi
  if have terminator; then
    terminator -x "$HOME/.scripts/desk" pkg-tui "$sub" &
  else
    notify "desk" "Open a terminal and run: desk pkg $sub"
  fi
}

desk_pkg_tui() {
  local sub="${1:-install}"
  local picks line
  local -a official=() aur=()
  need fzf || return 1

  case "$sub" in
    install|pacman|aur)
      need pacman || return 1
      echo "Building package list…"
      picks="$(
        {
          pacman -Slq
          _desk_aur_names | sed 's/$/  (AUR)/'
        } | _desk_pkg_pick "pkg > " "$HOME/.scripts/desk pkg-preview {}"
      )" || true
      [ -n "${picks:-}" ] || return 0
      while IFS= read -r line; do
        [ -n "$line" ] || continue
        if [[ "$line" == *"  (AUR)" ]]; then
          aur+=("${line%"  (AUR)"}")
        else
          official+=("$line")
        fi
      done <<<"$picks"
      if [ "${#official[@]}" -gt 0 ]; then
        sudo pacman -S --needed "${official[@]}"
      fi
      if [ "${#aur[@]}" -gt 0 ]; then
        need paru || return 1
        paru --aur -S --needed "${aur[@]}"
      fi
      ;;
    remove|drop)
      need pacman || return 1
      picks="$(pacman -Qqe | _desk_pkg_pick "remove > " 'pacman --color=never -Qi {} 2>/dev/null')" || true
      [ -n "${picks:-}" ] || return 0
      # shellcheck disable=SC2086
      sudo pacman -Rns $picks
      ;;
    *)
      echo "usage: desk pkg install|remove" >&2
      return 1
      ;;
  esac
}

# --- coding agents ----------------------------------------------------------

AGENT_DIR="${DESK_AGENT_DIR:-$HOME/Documents/Programming}"
AGENT_DEFAULT="$CONF/default-agent"
AGENTS_JSON="$CONF/agents.json"

_desk_agent_bin() {
  local row="$1" cand
  local bins
  bins="$(printf '%s' "$row" | jq -r '.bins // .bin')"
  for cand in $bins; do
    if have "$cand"; then
      printf '%s\n' "$cand"
      return 0
    fi
  done
  return 1
}

_desk_abbrev_home() {
  local p="$1"
  printf '%s\n' "${p/#$HOME/~}"
}

_desk_agent_remember_dir() {
  local dir="$1" rec="$CACHE/agent-dirs.txt"
  mkdir -p "$CACHE"
  {
    printf '%s\n' "$dir"
    grep -Fxv "$dir" "$rec" 2>/dev/null || true
  } | head -n 16 >"$rec.tmp"
  mv "$rec.tmp" "$rec"
}

_desk_agent_claude_dirs() {
  local jf="$HOME/.claude.json" enc d
  {
    if [ -r "$jf" ] && have jq; then
      jq -r '.projects | keys[]?' "$jf" 2>/dev/null
    fi
    for enc in "$HOME/.claude/projects"/-*; do
      [ -e "$enc" ] || continue
      d="${enc##*/}"
      d="${d//-/\/}"
      printf '%s\n' "$d"
    done
  } | awk -v home="$HOME" 'NF && $0 != home'
}

_desk_agent_git_dirs() {
  local root
  for root in "$AGENT_DIR" "$HOME/Documents/Programming" "$HOME/DataGripProjects" "$HOME/Projects"; do
    [ -d "$root" ] || continue
    if have fd; then
      fd -H -t d --max-depth 6 '^\.git$' "$root" -x dirname
    else
      find "$root" -maxdepth 5 -type d -name .git -printf '%h\n' 2>/dev/null
    fi
  done
}

_desk_agent_scan_dirs() {
  local -a roots=()
  local root
  for root in "$AGENT_DIR" "$HOME/Documents" "$HOME/Projects" "$HOME/DataGripProjects"; do
    [ -d "$root" ] || continue
    roots+=("$root")
  done
  [ "${#roots[@]}" -gt 0 ] || return 0
  if have fd; then
    fd -t d --max-depth 5 \
      --exclude node_modules --exclude .git --exclude .cache \
      --exclude target --exclude dist --exclude .next \
      --exclude venv --exclude __pycache__ \
      . "${roots[@]}"
  else
    find "${roots[@]}" -maxdepth 4 -type d \
      \( -name node_modules -o -name .git -o -name .cache \) -prune -o \
      -type d -print 2>/dev/null
  fi
}

_desk_agent_emit_dirs() {
  local d
  while IFS= read -r d; do
    [ -d "$d" ] || continue
    printf '%s\n' "$(_desk_abbrev_home "$d")"
  done
}

_desk_agent_new_dir() {
  local name parent="${AGENT_DIR}"
  [ -d "$parent" ] || parent="$HOME"
  name="$(printf '' | rofi_dmenu "New folder under $(_desk_abbrev_home "$parent")")" || return 1
  [ -n "$name" ] || return 1
  if [[ "$name" == /* || "$name" == ~* ]]; then
    name="${name/#\~/$HOME}"
  else
    name="$parent/$name"
  fi
  mkdir -p "$name" || { notify "AI" "Could not create $name"; return 1; }
  printf '%s\n' "$name"
}

_desk_agent_find_dir() {
  local choice
  choice="$(
    _desk_agent_scan_dirs | _desk_agent_emit_dirs | awk 'NF && !seen[$0]++' \
      | rofi_dmenu "Find folder"
  )" || return 1
  [ -n "$choice" ] || return 1
  choice="${choice/#\~/$HOME}"
  [ -d "$choice" ] || { notify "AI" "Not a folder: $choice"; return 1; }
  printf '%s\n' "$choice"
}

_desk_agent_browse_dir() {
  local start="${1:-$AGENT_DIR}"
  [ -d "$start" ] || start="$HOME"
  if have yad; then
    yad --file --directory --title="Project folder" --filename="$start/" 2>/dev/null
  else
    printf '%s' "$start" | rofi_dmenu "Path"
  fi
}

_desk_agent_pick_dir() {
  local rec="$CACHE/agent-dirs.txt"
  local start="${AGENT_DIR}"
  [ -d "$start" ] || start="$HOME"
  local lines="" d
  lines+="New folder…"$'\n'
  lines+="Find folder…"$'\n'
  lines+="Browse…"$'\n'
  if [ -s "$rec" ]; then
    lines+="$(_desk_agent_emit_dirs <"$rec")"
    lines+=$'\n'
  fi
  lines+="$(_desk_agent_claude_dirs | _desk_agent_emit_dirs)"$'\n'
  if [ -d "$start" ]; then
    lines+="$(_desk_abbrev_home "$start")"$'\n'
    while IFS= read -r d; do
      [ -d "$d" ] || continue
      lines+="$(_desk_abbrev_home "$d")"$'\n'
    done < <(find "$start" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | sort)
  fi
  lines+="$(_desk_agent_git_dirs | _desk_agent_emit_dirs)"$'\n'
  local choice
  choice="$(printf '%s' "$lines" | awk 'NF && !seen[$0]++' | rofi_dmenu "Project folder")" || return 1
  [ -n "$choice" ] || return 1
  case "$choice" in
    "New folder…")
      choice="$(_desk_agent_new_dir)" || return 1
      ;;
    "Find folder…")
      choice="$(_desk_agent_find_dir)" || return 1
      ;;
    "Browse…")
      choice="$(_desk_agent_browse_dir "$start")" || return 1
      ;;
    *)
      choice="${choice/#\~/$HOME}"
      ;;
  esac
  [ -d "$choice" ] || { notify "AI" "Not a folder: $choice"; return 1; }
  _desk_agent_remember_dir "$choice"
  printf '%s\n' "$choice"
}

_desk_agent_term() {
  local root="$1" title="$2"
  shift 2
  # Agent must be Terminator's child. A `zsh -c` wrapper makes TUIs
  # (grok, claude, …) see no tty and exit, so the window flashes shut.
  terminator --working-directory="$root" -T "$title" -x "$@" &
}

_desk_agent_shell() {
  local root="$1" title="$2"
  shift 2
  terminator --working-directory="$root" -T "$title" \
    -x zsh -i -c "$* || true; echo; printf 'Enter to close... '; read -r" &
}

desk_agent_launch() {
  local id="$1"
  local root="${2:-}"
  local row kind bin args npx install binname
  [ -n "$root" ] || root="$(_desk_agent_pick_dir)" || return 0
  row="$(jq -c --arg id "$id" '.[] | select(.id == $id)' "$AGENTS_JSON")"
  [ -n "$row" ] || { notify "AI" "Unknown agent: $id"; return 1; }
  kind="$(printf '%s' "$row" | jq -r '.kind')"
  args="$(printf '%s' "$row" | jq -r '.args // empty')"
  npx="$(printf '%s' "$row" | jq -r '.npx // empty')"
  install="$(printf '%s' "$row" | jq -r '.install // empty')"
  binname="$(printf '%s' "$row" | jq -r '.bin')"

  if bin="$(_desk_agent_bin "$row")"; then
    case "$kind" in
      gui)
        (cd "$root" && "$bin" "$root") &
        ;;
      *)
        # shellcheck disable=SC2086
        _desk_agent_term "$root" "agent: $id" "$bin" $args
        ;;
    esac
    return 0
  fi

  if [ "$kind" = "npx" ] && [ -n "$npx" ]; then
    # shellcheck disable=SC2086
    _desk_agent_term "$root" "agent: $id" $npx
    return 0
  fi

  if [ -n "$install" ]; then
    notify -u low "AI" "Installing $(printf '%s' "$row" | jq -r '.name')…"
    _desk_agent_shell "$root" "install: $id" "$install && exec $binname"
    return 0
  fi

  notify "AI" "$(printf '%s' "$row" | jq -r '.name') is not installed"
}

desk_agent_pick() {
  need jq || return 1
  [ -r "$AGENTS_JSON" ] || return 1
  local default="" line id label mark choice
  [ -r "$AGENT_DEFAULT" ] && default="$(tr -d '[:space:]' <"$AGENT_DEFAULT")"
  local rows=""
  while IFS= read -r line; do
    id="$(printf '%s' "$line" | jq -r '.id')"
    label="$(printf '%s' "$line" | jq -r '.name')"
    mark=""
    [ "$id" = "$default" ] && mark=" *"
    if _desk_agent_bin "$line" >/dev/null; then
      rows+="${label}${mark}"$'\n'
    elif [ "$(printf '%s' "$line" | jq -r '.kind')" = "npx" ]; then
      rows+="${label}${mark}  (npx)"$'\n'
    else
      rows+="${label}${mark}  — install"$'\n'
    fi
  done < <(jq -c '.[]' "$AGENTS_JSON")
  choice="$(printf '%s' "$rows" | rofi_dmenu "AI agents")" || return 0
  [ -n "$choice" ] || return 0
  choice="${choice%%  — *}"
  choice="${choice%%  (npx)*}"
  choice="${choice% \*}"
  id="$(jq -r --arg n "$choice" '.[] | select(.name == $n) | .id' "$AGENTS_JSON")"
  [ -n "$id" ] || return 1
  desk_agent_launch "$id"
}

desk_agent_default() {
  local id=""
  if [ -r "$AGENT_DEFAULT" ]; then
    id="$(tr -d '[:space:]' <"$AGENT_DEFAULT")"
  elif have claude; then
    id="claude"
  fi
  if [ -n "$id" ]; then
    desk_agent_launch "$id"
  else
    desk_agent_pick
  fi
}

desk_agent_set() {
  local id="${1:-}"
  if [ -z "$id" ]; then
    id="$(jq -r '.[].id' "$AGENTS_JSON" | rofi_dmenu "Default agent")" || return 0
  fi
  [ -n "$id" ] || return 0
  mkdir -p "$CONF"
  printf '%s\n' "$id" >"$AGENT_DEFAULT"
  notify -u low "AI" "Default agent: $id"
}

desk_agent() {
  local sub="${1:-pick}"
  case "$sub" in
    pick|menu) desk_agent_pick ;;
    default|launch) desk_agent_default ;;
    set) desk_agent_set "${2:-}" ;;
    *) desk_agent_launch "$sub" ;;
  esac
}

# --- default apps -----------------------------------------------------------

_desk_default_primary_mime() {
  case "$1" in
    browser) echo "x-scheme-handler/https" ;;
    terminal) echo "x-scheme-handler/terminal" ;;
    files) echo "inode/directory" ;;
    editor) echo "text/plain" ;;
    pdf) echo "application/pdf" ;;
    images) echo "image/jpeg" ;;
    *) return 1 ;;
  esac
}

_desk_default_mimes() {
  case "$1" in
    browser) echo "text/html application/xhtml+xml x-scheme-handler/http x-scheme-handler/https x-scheme-handler/about x-scheme-handler/unknown" ;;
    terminal) echo "x-scheme-handler/terminal application/x-terminal-emulator" ;;
    files) echo "inode/directory" ;;
    editor) echo "text/plain" ;;
    pdf) echo "application/pdf" ;;
    images) echo "image/jpeg image/png image/gif image/webp" ;;
    *) return 1 ;;
  esac
}

_desk_default_helper_key() {
  case "$1" in
    browser) echo "WebBrowser" ;;
    terminal) echo "TerminalEmulator" ;;
    files) echo "FileManager" ;;
    *) echo "" ;;
  esac
}

_desk_desktop_find() {
  local id="${1%.desktop}.desktop" dir
  for dir in \
    "${XDG_DATA_HOME:-$HOME/.local/share}/applications" \
    /usr/local/share/applications \
    /usr/share/applications
  do
    if [ -f "$dir/$id" ]; then
      printf '%s\n' "$dir/$id"
      return 0
    fi
  done
  return 1
}

_desk_desktop_name() {
  local id="$1" f
  f="$(_desk_desktop_find "$id")" || { printf '%s\n' "${id%.desktop}"; return 0; }
  awk -F= '
    $0 == "[Desktop Entry]" { ine = 1; next }
    ine && /^\[/ { exit }
    ine && $1 == "Name" { print substr($0, index($0, "=") + 1); exit }
  ' "$f"
}

_desk_default_current() {
  local role="$1" mime id
  mime="$(_desk_default_primary_mime "$role")" || return 1
  if [ "$role" = "browser" ] && have xdg-settings; then
    id="$(xdg-settings get default-web-browser 2>/dev/null || true)"
  fi
  if [ -z "${id:-}" ]; then
    id="$(xdg-mime query default "$mime" 2>/dev/null || true)"
  fi
  printf '%s\n' "$id"
}

_desk_default_list() {
  local role="$1"
  python3 - "$role" <<'PY'
import os, sys
from pathlib import Path

role = sys.argv[1]
mimes = {
    "browser": ["x-scheme-handler/http", "x-scheme-handler/https"],
    "terminal": ["x-scheme-handler/terminal", "application/x-terminal-emulator"],
    "files": ["inode/directory"],
    "editor": ["text/plain"],
    "pdf": ["application/pdf"],
    "images": ["image/jpeg", "image/png", "image/gif", "image/webp"],
}[role]
cats = {
    "browser": ["WebBrowser"],
    "terminal": ["TerminalEmulator"],
    "files": ["FileManager"],
    "editor": ["TextEditor"],
    "pdf": [],
    "images": [],
}[role]

def desktop_dirs():
    out = []
    home = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share"))
    out.append(home / "applications")
    for raw in os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":"):
        if raw:
            out.append(Path(raw) / "applications")
    return [d for d in out if d.is_dir()]

def parse(path: Path):
    fields = {}
    in_entry = False
    try:
        text = path.read_text(errors="replace")
    except OSError:
        return fields
    for line in text.splitlines():
        if line.strip() == "[Desktop Entry]":
            in_entry = True
            continue
        if in_entry and line.startswith("[") and line.endswith("]"):
            break
        if in_entry and "=" in line and not line.startswith("#"):
            key, _, val = line.partition("=")
            if key not in fields:
                fields[key] = val
    return fields

seen = set()
rows = []
for d in desktop_dirs():
    for path in sorted(d.glob("*.desktop")):
        name = path.name
        if name in seen:
            continue
        seen.add(name)
        if name.endswith("-settings.desktop") or "bulk-rename" in name:
            continue
        f = parse(path)
        if f.get("Type", "Application") != "Application":
            continue
        if f.get("NoDisplay", "").lower() == "true":
            continue
        if f.get("Hidden", "").lower() == "true":
            continue
        mime = [m for m in f.get("MimeType", "").split(";") if m]
        cat = [c for c in f.get("Categories", "").split(";") if c]
        if not (set(mime) & set(mimes) or set(cat) & set(cats)):
            continue
        label = f.get("Name") or name.removesuffix(".desktop")
        rows.append((label.lower(), label, name))

for _, label, name in sorted(rows):
    print(f"{name}\t{label}")
PY
}

_desk_default_set_helper() {
  local key="$1" val="${2%.desktop}"
  local f="${XDG_CONFIG_HOME:-$HOME/.config}/xfce4/helpers.rc"
  [ -n "$key" ] || return 0
  mkdir -p "$(dirname "$f")"
  touch "$f"
  if grep -q "^${key}=" "$f"; then
    sed -i "s|^${key}=.*|${key}=${val}|" "$f"
  else
    printf '%s=%s\n' "$key" "$val" >>"$f"
  fi
}

_desk_default_apply() {
  local role="$1" id="${2%.desktop}.desktop" mime helper
  _desk_desktop_find "$id" >/dev/null || { notify "Defaults" "No desktop file: $id"; return 1; }
  for mime in $(_desk_default_mimes "$role"); do
    xdg-mime default "$id" "$mime" || true
  done
  if [ "$role" = "browser" ] && have xdg-settings; then
    xdg-settings set default-web-browser "$id" 2>/dev/null || true
  fi
  helper="$(_desk_default_helper_key "$role")"
  if [ -n "$helper" ]; then
    _desk_default_set_helper "$helper" "$id"
  fi
  notify -u low "Defaults" "${role^} → $(_desk_desktop_name "$id")"
}

desk_default() {
  local role="${1:-}" id current name mark choice line
  if [ -z "$role" ]; then
    local rows=""
    for role in browser terminal files editor pdf images; do
      current="$(_desk_default_current "$role")"
      name="$( [ -n "$current" ] && _desk_desktop_name "$current" )"
      if [ -n "$name" ]; then
        rows+="${role^}  ($name)"$'\n'
      else
        rows+="${role^}"$'\n'
      fi
    done
    choice="$(printf '%s' "$rows" | rofi_dmenu "Defaults")" || return 0
    [ -n "$choice" ] || return 0
    role="$(printf '%s' "$choice" | awk '{print tolower($1)}')"
  fi
  _desk_default_primary_mime "$role" >/dev/null || {
    echo "usage: desk default [browser|terminal|files|editor|pdf|images]" >&2
    return 1
  }
  current="$(_desk_default_current "$role")"
  local lines=""
  while IFS=$'\t' read -r id name; do
    [ -n "$id" ] || continue
    [ -n "$name" ] || name="$id"
    if [ "$id" = "$current" ]; then
      mark="● "
    else
      mark="  "
    fi
    lines+="${mark}${name}"$'\t'"${id}"$'\n'
  done < <(_desk_default_list "$role")
  [ -n "$lines" ] || { notify "Defaults" "No apps found for $role"; return 1; }
  choice="$(printf '%s' "$lines" | rofi_dmenu "Default $role")" || return 0
  [ -n "$choice" ] || return 0
  id="$(printf '%s' "$choice" | awk -F'\t' '{print $NF}')"
  [ -n "$id" ] || return 1
  _desk_default_apply "$role" "$id"
}

desk_open() {
  local role="${1:-}" id f
  _desk_default_primary_mime "$role" >/dev/null || {
    echo "usage: desk open browser|terminal|files|editor|pdf|images" >&2
    return 1
  }
  id="$(_desk_default_current "$role")"
  [ -n "$id" ] || { notify "desk" "No default $role set"; return 1; }
  f="$(_desk_desktop_find "$id")" || { notify "desk" "Missing $id"; return 1; }
  if have gtk-launch; then
    gtk-launch "${id%.desktop}" >/dev/null 2>&1 &
  elif have gio; then
    gio launch "$f" >/dev/null 2>&1 &
  else
    notify "desk" "Need gtk-launch to open $role"
    return 1
  fi
}

desk_help() {
  cat <<'EOF'
desk <verb> [args]

  menu              Unified rofi (commands + apps + windows)
  apps              Apps-only launcher
  rofi [selection]  Rofi script mode (used by desk-menu)
  clipboard         Clipboard history
  notify            replay | replay-many | dnd-toggle | status
  capture           ocr | qr | annotate | region | full | window
  theme             ensure | apply | pick | randomize | catalog | fetch | review
  wifi              tui | rofi | gui   (wifitui, else the old list)
  audio             tui | rofi | gui   (wiremix, else sink list)
  cava              Toggle visualizer
  bluetooth         tui | rofi | gui   (bluetui, else the old list)
  display           Autorandr / mapped layout
  power             Lock / logout / suspend / reboot / shutdown
  weather           Forecast toast
  weather-bar       One-line polybar text
  keys              Searchable i3 binds
  emoji             rofimoji
  lock              Lock screen
  update            full-update in a terminal
  pkg               install | remove   (official + AUR, fzf)
  agent             pick | default | set [id] | <id>
  default           [browser|terminal|files|editor|pdf|images]
  open              browser|terminal|files|editor|pdf|images
  help              This list
EOF
}

# --- router -----------------------------------------------------------------

main() {
  local cmd="${1:-help}"
  shift || true
  case "$cmd" in
    menu) desk_menu ;;
    apps) desk_apps ;;
    rofi) desk_rofi "${1:-}" ;;
    clipboard|clip) desk_clipboard ;;
    notify) desk_notify "${1:-status}" ;;
    capture) desk_capture "${1:-}" ;;
    theme) desk_theme "${@:-ensure}" ;;
    wifi|network) desk_wifi "${1:-}" ;;
    audio) desk_audio "${1:-}" ;;
    cava|visualizer) desk_cava ;;
    bluetooth|bt) desk_bluetooth "${1:-}" ;;
    display) desk_display ;;
    power) desk_power ;;
    weather) desk_weather ;;
    weather-bar) desk_weather_bar ;;
    keys) desk_keys ;;
    emoji) desk_emoji ;;
    lock) desk_lock ;;
    update) desk_update ;;
    pkg) desk_pkg "${1:-install}" ;;
    pkg-tui) desk_pkg_tui "${1:-install}" ;;
    pkg-preview) desk_pkg_preview "${1:-}" ;;
    agent) desk_agent "$@" ;;
    default|defaults) desk_default "${1:-}" ;;
    open) desk_open "${1:-}" ;;
    help|-h|--help) desk_help ;;
    *)
      echo "desk: unknown command '$cmd'" >&2
      desk_help >&2
      return 1
      ;;
  esac
}

main "$@"
