{
  "enabledPlugins": {
    "vercel@claude-plugins-official": true,
    "mattpocock-skills@claude-plugins-official": true
  },
  "tui": "fullscreen",
  "theme": "dark",
  "editorMode": "vim",
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/.env.production.local)",
      "Read(**/.env.development)",
      "Read(**/.env.development.local)",
      "Read(**/.env.test)",
      "Read(**/.env.test.local)",
      "Read(**/.env.staging)",
      "Read(**/.env.staging.local)",
      "Read(**/.env.prod)",
      "Read(**/.env.prod.local)",
      "Read(**/.env.dev)",
      "Read(**/.env.dev.local)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa)",
      "Read(**/id_rsa.*)",
      "Read(**/id_ed25519)",
      "Read(**/id_ed25519.*)",
      "Read(**/credentials.json)",
      "Read(**/*.pfx)",
      "Read(**/*.p12)",
      "Grep(**/.env)",
      "Grep(**/.env.local)",
      "Grep(**/.env.production)",
      "Grep(**/.env.production.local)",
      "Grep(**/.env.development)",
      "Grep(**/.env.development.local)",
      "Grep(**/.env.test)",
      "Grep(**/.env.test.local)",
      "Grep(**/.env.staging)",
      "Grep(**/.env.staging.local)",
      "Grep(**/.env.prod)",
      "Grep(**/.env.prod.local)",
      "Grep(**/.env.dev)",
      "Grep(**/.env.dev.local)",
      "Grep(**/*.pem)",
      "Grep(**/*.key)",
      "Grep(**/id_rsa)",
      "Grep(**/id_rsa.*)",
      "Grep(**/id_ed25519)",
      "Grep(**/id_ed25519.*)",
      "Grep(**/credentials.json)",
      "Grep(**/*.pfx)",
      "Grep(**/*.p12)"
    ],
    "ask": [
      "Read(**/.env.*)",
      "Grep(**/.env.*)"
    ]
  }
}
